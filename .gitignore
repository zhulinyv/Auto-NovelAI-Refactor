# ================= Python =================
__pycache__/
*.py[codz]
*$py.class
venv/
Python/

# ================= 测试与日志 =================
# 根目录的 test.* 是作者手工调试用的散件, 不进版本库;
# tests/ 下的契约测试是仓库资产, 必须跟踪 (见 tests/test_contracts.py)
test.*
tests/
# tests/ 下的契约测试是仓库资产 (前后端镜像算法的回归保护), 单独放行
!/tests/
!/tests/test_contracts.py
*.log

# ================= 环境与输出 =================
.env
outputs/

# 用户配置与"上次生成参数": 刻意放在项目根目录, 方便直接查看 / 手改 / 备份。
# 它们含 Token 等敏感信息, 绝不能进版本库。
settings.json
last.json

# data/: 其余"非源码"的运行时数据 —— 状态 / 缓存 / 临时文件 / 托管窗口的浏览器 profile。
# 历史上这些散落在 outputs/ 下, 与用户的生成图片混在一起; 现在统一收进一个目录, 整目录忽略。
data/
# 例外: 仓库自带的示例 Vibe (克隆后自动入库, 无需手动导入)。
# 注意 git 不会进入被忽略的目录, 所以必须逐层放行再逐层重新忽略, 只留这两个文件。
!data/
data/*
!data/state/
data/state/*
!data/state/vibes/
data/state/vibes/*
# 自建 Vibe 条目: <id>.json + 同名缩略图 (jpg/png) 成对放行, 原图另在 img/ 下逐层放行。
# 新增条目时要在这里补对应的 id, 否则会被上面的 data/state/vibes/* 忽略掉。
!data/state/vibes/b60f7a2710a5.json
!data/state/vibes/b60f7a2710a5.jpg
!data/state/vibes/cfcf0b91eee4.json
!data/state/vibes/cfcf0b91eee4.jpg
!data/state/vibes/img/
data/state/vibes/img/*
!data/state/vibes/img/b60f7a2710a5.png
!data/state/vibes/img/cfcf0b91eee4.png

# 旧位置 (迁移后不再产生, 保留以免历史工作副本里的文件被误提交)
.webui-browser/
bg_state.json

